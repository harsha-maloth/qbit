---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="panel">
  <h2>{title}</h2>
  <p><slot /></p>
</section>

<style>
  .panel { border-radius: var(--radius); border: 1px solid var(--line); padding: 1.75rem; background: var(--surface); }
  h2 { font-size: 1.25rem; letter-spacing: -0.01em; }
  p { margin-top: 0.75rem; color: var(--text-muted); line-height: 1.7; }
</style>
