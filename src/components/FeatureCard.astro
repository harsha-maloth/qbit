---
interface Props {
  title: string;
  label?: string;
}
const { title, label } = Astro.props;
---

<article class="card">
  {label && <p class="label">{label}</p>}
  <h3>{title}</h3>
  <p class="body"><slot /></p>
</article>

<style>
  .card {
    border-radius: var(--radius); border: 1px solid var(--line); padding: 2rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
  }
  .label { margin-bottom: 1rem; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  h3 { font-size: 1.35rem; }
  .body { margin-top: 1rem; color: var(--text-muted); line-height: 1.8; }
</style>
