---
interface Props {
  title: string;
  label?: string;
}
const { title, label } = Astro.props;
---

<article class="card">
  {label && <p class="label">{label}</p>}
  <h3>{title}</h3>
  <p class="body"><slot /></p>
</article>

<style>
  .card {
    border-radius: var(--radius); border: 1px solid var(--line); padding: 1.75rem;
    background: var(--surface);
  }
  .label { margin-bottom: 0.75rem; font-size: 0.9rem; font-weight: 600; color: var(--accent); }
  h3 { font-size: 1.25rem; letter-spacing: -0.01em; }
  .body { margin-top: 0.75rem; color: var(--text-muted); line-height: 1.7; }
</style>
