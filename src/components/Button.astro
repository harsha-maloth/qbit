---
import { withBase } from "../lib/url";
interface Props {
  href?: string;
  variant?: "primary" | "ghost";
  type?: "button" | "submit";
  disabled?: boolean;
}
const { href, variant = "primary", type = "button", disabled = false } = Astro.props;
const external = href?.startsWith("http");
const finalHref = href ? withBase(href) : undefined;
---

{href ? (
  <a class:list={["btn", variant]} href={finalHref} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
    <slot />
  </a>
) : (
  <button class:list={["btn", variant]} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    border: 1px solid transparent; border-radius: var(--radius-sm); padding: 0.8rem 1.4rem;
    font-weight: 600; font-size: 0.95rem; line-height: 1.2;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .primary { background: var(--accent); color: var(--on-accent); }
  .primary:hover { background: var(--accent-dark); }
  .ghost { background: transparent; color: var(--text); border-color: var(--text); }
  .ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn:disabled { opacity: 0.6; cursor: not-allowed; }
</style>
