---
interface Props {
  href?: string;
  variant?: "primary" | "ghost";
  type?: "button" | "submit";
  disabled?: boolean;
}
const { href, variant = "primary", type = "button", disabled = false } = Astro.props;
const external = href?.startsWith("http");
---

{href ? (
  <a class:list={["btn", variant]} href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
    <slot />
  </a>
) : (
  <button class:list={["btn", variant]} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    border: 1px solid transparent; border-radius: 999px; padding: 0.95rem 1.75rem;
    font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.9rem;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .primary { background: var(--accent); color: var(--on-accent); }
  .primary:hover { background: var(--accent-dark); transform: translateY(-1px); }
  .ghost { background: transparent; color: var(--text); border-color: var(--border-strong); }
  .ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
</style>
