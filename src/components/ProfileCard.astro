---
interface Props {
  name: string;
  role: string;
  photo?: string;
  bio?: string;
}
const { name, role, photo, bio } = Astro.props;
// Initials fallback until real photos are supplied.
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0]!.toUpperCase()).join("");
---

<article class="profile">
  {photo ? (
    <img class="avatar" src={photo} alt={`Portrait of ${name}`} width="400" height="400" loading="lazy" />
  ) : (
    <div class="avatar placeholder" aria-hidden="true">{initials}</div>
  )}
  <div class="meta">
    <h3>{name}</h3>
    <p class="role">{role}</p>
    {bio && <p class="bio">{bio}</p>}
  </div>
</article>

<style>
  .profile {
    border-radius: var(--radius); border: 1px solid var(--line); padding: 1.8rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
  }
  .avatar { width: 100%; aspect-ratio: 1; border-radius: 28px; object-fit: cover; }
  .placeholder {
    display: grid; place-items: center; font-size: 3rem; font-weight: 800; color: var(--accent);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 184, 0, 0.12));
  }
  .meta { margin-top: 1.5rem; }
  h3 { font-size: 1rem; margin-bottom: 0.35rem; }
  .role { color: var(--text-muted); font-size: 0.95rem; }
  .bio { margin-top: 0.75rem; color: var(--text-muted); line-height: 1.7; font-size: 0.95rem; }
</style>
