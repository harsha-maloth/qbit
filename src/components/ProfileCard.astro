---
interface Props {
  name: string;
  role: string;
  photo?: string;
  bio?: string;
}
const { name, role, photo, bio } = Astro.props;
// Initials fallback until real photos are supplied.
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0]!.toUpperCase()).join("");
---

<article class="profile">
  {photo ? (
    <img class="avatar" src={photo} alt={`Portrait of ${name}`} width="400" height="400" loading="lazy" />
  ) : (
    <div class="avatar placeholder" aria-hidden="true">{initials}</div>
  )}
  <div class="meta">
    <h3>{name}</h3>
    <p class="role">{role}</p>
    {bio && <p class="bio">{bio}</p>}
  </div>
</article>

<style>
  .profile { border-radius: var(--radius); border: 1px solid var(--line); padding: 1.5rem; background: var(--surface); }
  .avatar { width: 100%; aspect-ratio: 1; border-radius: var(--radius); object-fit: cover; }
  .placeholder {
    display: grid; place-items: center; font-size: 3rem; font-weight: 600; color: var(--accent);
    font-family: var(--font-display); background: var(--accent-soft);
  }
  .meta { margin-top: 1.25rem; }
  h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .role { color: var(--text-muted); font-size: 0.95rem; }
  .bio { margin-top: 0.75rem; color: var(--text-muted); line-height: 1.65; font-size: 0.95rem; }
</style>
