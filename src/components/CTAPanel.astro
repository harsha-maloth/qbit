---
import Badge from "./Badge.astro";
interface Props {
  badge?: string;
  title: string;
}
const { badge, title } = Astro.props;
---

<div class="container cta-panel">
  {badge && <Badge>{badge}</Badge>}
  <h2>{title}</h2>
  <p><slot /></p>
  <div class="actions"><slot name="actions" /></div>
</div>

<style>
  .cta-panel { padding: 3rem; text-align: left; border-radius: var(--radius-lg); background: var(--ink); color: var(--on-ink); }
  .cta-panel :global(.badge) { color: #B8C4FF; }
  h2 { margin: 0.75rem 0 0; max-width: 24ch; font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.03em; color: #fff; }
  p { max-width: 62ch; margin: 1rem 0 0; color: var(--on-ink-muted); line-height: 1.7; }
  .actions { display: flex; justify-content: flex-start; margin-top: 2rem; }
  .actions :global(.btn.primary) { background: #fff; color: var(--ink); }
  .actions :global(.btn.primary:hover) { background: var(--accent-soft); }
  @media (max-width: 720px) { .cta-panel { padding: 2rem 1.25rem; } }
</style>
