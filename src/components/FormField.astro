---
interface Props {
  id: string;
  name?: string;
  label: string;
  as?: "input" | "textarea" | "select";
  type?: "text" | "email" | "url" | "number" | "tel";
  required?: boolean;
  hint?: string;
  autocomplete?: string;
  maxlength?: number;
  minlength?: number;
  rows?: number;
  min?: number;
  max?: number;
}
const { id, name = id, label, as = "input", type = "text", required = false, hint, autocomplete, maxlength, minlength, rows = 6, min, max } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedby = [hintId, errorId].filter(Boolean).join(" ");
---

<div class="field">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}{required && <span class="sr-only"> (required)</span>}</label>
  {as === "textarea" && (
    <textarea id={id} name={name} rows={rows} required={required} maxlength={maxlength} minlength={minlength} aria-describedby={describedby}></textarea>
  )}
  {as === "select" && (
    <select id={id} name={name} required={required} aria-describedby={describedby}><slot /></select>
  )}
  {as === "input" && (
    <input id={id} name={name} type={type} required={required} autocomplete={autocomplete} maxlength={maxlength} minlength={minlength} min={min} max={max} aria-describedby={describedby} />
  )}
  {hint && <p class="hint" id={hintId}>{hint}</p>}
  <p class="error" id={errorId} role="alert" hidden></p>
</div>

<style>
  .field { display: grid; gap: 0.55rem; }
  label { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  input, select, textarea {
    width: 100%; padding: 1rem; border-radius: 18px; color: var(--text);
    border: 1px solid rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px rgba(255, 184, 0, 0.18); }
  textarea { min-height: 160px; resize: vertical; }
  .hint { font-size: 0.85rem; color: var(--text-subtle); }
  .error { font-size: 0.9rem; color: #ffb4a8; }
  .error[hidden] { display: none; }
</style>
