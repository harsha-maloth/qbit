---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import CTAPanel from "../../components/CTAPanel.astro";
import Button from "../../components/Button.astro";
import { programs } from "../../data/programs";
---

<BaseLayout title="Programs" description="Collective Qubits programs for quantum systems, responsible AI, neurotech and sensing, and systems design.">
  <PageHeader badge="Programs" title="Focus areas where collective intelligence makes the difference.">
    We support teams building at the intersection of science, technology, and society across these areas.
  </PageHeader>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        {programs.map((p) => <FeatureCard label="Program" title={p.name}>{p.summary}</FeatureCard>)}
      </div>
    </div>
  </section>

  <section class="section">
    <CTAPanel title="Not sure where your project fits?">
      Apply anyway. Describe what you are building and our team will tell you how we can help.
      <Button slot="actions" href="/apply/">Apply now</Button>
    </CTAPanel>
  </section>
</BaseLayout>
