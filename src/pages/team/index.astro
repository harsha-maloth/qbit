---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProfileCard from "../../components/ProfileCard.astro";
import { team } from "../../data/team";
---

<BaseLayout title="Team" description="Meet the founders, advisors, and operators behind Collective Qubits.">
  <PageHeader badge="Team" title="Meet the people helping founders turn science and systems thinking into launch-ready ventures.">
    Our collective includes founders, researchers, operators, and mentors with deep experience in emerging technology and ecosystem design.
  </PageHeader>

  <section class="section">
    <h2 class="sr-only">Team members</h2>
    <div class="container grid-3">
      {team.map((m) => <ProfileCard name={m.name} role={m.role} photo={m.photo} bio={m.bio} />)}
    </div>
  </section>
</BaseLayout>
