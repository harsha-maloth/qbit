---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Panel from "../../components/Panel.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import Badge from "../../components/Badge.astro";
import CTAPanel from "../../components/CTAPanel.astro";
import Button from "../../components/Button.astro";
---

<BaseLayout title="Mission" description="Collective Qubits helps deep-tech teams build responsible futures with clarity, focus, and momentum.">
  <PageHeader badge="Mission" title="We help deep-tech teams build responsible futures with clarity, focus, and momentum.">
    Collective Qubits supports founders, researchers, and hybrid teams with strategic guidance, community connections, and practical launch support for science-forward ventures.
  </PageHeader>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        <Panel title="Our promise">We help teams take the next step by translating ambitious research into grounded products and meaningful collaborations. Our support blends product strategy, funding readiness, and systems thinking.</Panel>
        <Panel title="Who we support">Founders and research teams building at the intersection of quantum, AI, photonics, neurotech, and complex systems. We work with leaders who care about both technical excellence and positive societal impact.</Panel>
      </div>

      <div class="grid-3 mt-lg">
        <FeatureCard label="Vision" title="Systems-level impact">We design programs for work that changes systems, not just products. That means considering policy, culture, ethics, and long-term resilience.</FeatureCard>
        <FeatureCard label="Practice" title="Iterate with intention">Teams move faster when every experiment is aligned to a clear problem statement, audience, and real-world signal.</FeatureCard>
        <FeatureCard label="Support" title="Mentorship and access">We connect founders to experts in deep technology, creative practice, business, and community systems to accelerate meaningful outcomes.</FeatureCard>
      </div>

      <div class="section-head mt-lg">
        <Badge>Approach</Badge>
        <h2 class="section-title">We combine product clarity, scientific rigor, and ethical judgment.</h2>
        <p class="section-subtitle">Our approach is practical, experimental, and grounded in collaborative learning. We help teams move from early inquiry to launch-stage readiness.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <CTAPanel title="Building something ambitious?">
      Tell us about your project and what you need to take the next step.
      <Button slot="actions" href="/apply/">Apply now</Button>
    </CTAPanel>
  </section>
</BaseLayout>
