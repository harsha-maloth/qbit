---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FormField from "../../components/FormField.astro";
import Button from "../../components/Button.astro";
import { site } from "../../data/site";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const endpoint = supabaseUrl ? `${supabaseUrl.replace(/\/$/, "")}/functions/v1/apply` : "";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const contact = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "";
---

<BaseLayout title="Apply" description="Apply to Collective Qubits as a founder, researcher, or hybrid team building deep-tech ventures.">
  <PageHeader badge="Apply" title="Submit your application to Collective Qubits.">
    We are looking for founders and teams building with purpose, technical ambition, and the potential to shape emerging systems.
  </PageHeader>

  <section class="section">
    <div class="container">
      <div class="form-card">
        <form id="apply-form" novalidate data-endpoint={endpoint} data-sitekey={siteKey} data-contact={contact}>
          <div class="form-grid">
            <FormField id="name" label="Full name" required autocomplete="name" minlength={2} maxlength={120} />
            <FormField id="email" label="Email address" type="email" required autocomplete="email" maxlength={254} />
            <FormField id="affiliation" label="Affiliation" required autocomplete="organization" minlength={2} maxlength={160} hint="Company or institution" />
            <FormField id="stage" label="Current stage" as="select" required>
              <option value="">Select stage</option>
              <option>Early Prototype</option>
              <option>Research Phase</option>
              <option>Pre-launch</option>
            </FormField>
            <FormField id="focus" label="Project focus" required minlength={2} maxlength={200} hint="For example: quantum systems, responsible AI, neurotech" />
            <FormField id="team_size" label="Team size (optional)" type="number" min={1} max={500} />
          </div>
          <div class="stack">
            <FormField id="summary" label="What are you building?" as="textarea" required minlength={20} maxlength={4000} rows={6} hint="At least 20 characters. Describe the project and its impact. Please do not include confidential information." />
            <FormField id="website" label="Website (optional)" type="url" maxlength={300} hint="Include https://" />

            <div class="hp" aria-hidden="true">
              <label for="hp">Leave this field empty</label>
              <input id="hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="consent">
              <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-error" />
              <label for="consent">I agree that Collective Qubits may store and use these details to review my application, as described in the <a href="/privacy/">Privacy Policy</a>.<span class="sr-only"> (required)</span></label>
            </div>
            <p class="error" id="consent-error" role="alert" hidden></p>

            <div id="turnstile-box" class="turnstile-box"></div>
          </div>

          <div class="form-actions">
            <Button type="submit">Submit application</Button>
            <p id="form-status" class="status" role="status" aria-live="polite"></p>
          </div>
        </form>
        <noscript><p class="status">This form needs JavaScript. You can also reach us on <a href={site.discord}>Discord</a>.</p></noscript>
      </div>

      <p class="fallback">
        Trouble with the form?
        {contact ? (
          <>Email us at <a href={`mailto:${contact}`}>{contact}</a>.</>
        ) : (
          <>Reach us on <a href={site.discord} target="_blank" rel="noopener noreferrer">Discord<span class="sr-only"> (opens in a new tab)</span></a>.</>
        )}
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import "../../scripts/apply";
</script>

<style>
  .form-card { background: rgba(12, 14, 19, 0.92); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 28px; padding: 2rem; }
  .form-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stack { display: grid; gap: 1.25rem; margin-top: 1.25rem; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .consent { display: flex; gap: 0.85rem; align-items: flex-start; }
  .consent input { width: 1.4rem; height: 1.4rem; margin-top: 0.15rem; accent-color: var(--accent); flex: none; }
  .consent label { color: var(--text-muted); line-height: 1.6; }
  .consent a, .fallback a, .status a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .error { font-size: 0.9rem; color: #ffb4a8; margin-top: -0.5rem; }
  .error[hidden] { display: none; }
  .turnstile-box { min-height: 65px; }
  .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.5rem; }
  .status { color: var(--text-muted); min-height: 1.5rem; }
  .status.is-error { color: #ffb4a8; }
  .fallback { margin-top: 1.5rem; color: var(--text-muted); }
  @media (max-width: 720px) {
    .form-card { padding: 1.25rem; }
    .form-grid { grid-template-columns: 1fr; }
  }
</style>
