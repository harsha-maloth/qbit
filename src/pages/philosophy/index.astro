---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CTAPanel from "../../components/CTAPanel.astro";
import Button from "../../components/Button.astro";
---

<BaseLayout title="Philosophy" description="How Collective Qubits builds deep-tech teams: with intent, curiosity, and a strong sense of human impact.">
  <PageHeader badge="Philosophy" title="We build with intent, curiosity, and a strong sense of human impact.">
    Innovation is not accidental. We choose problems that matter, design with empathy, and measure progress by the quality of the outcomes we create.
  </PageHeader>

  <section class="section">
    <div class="container">
      <ul class="rows">
        <li>
          <h2>Context matters</h2>
          <p>Technical breakthroughs are strongest when they are rooted in user needs, ethical judgment, and long-term resilience.</p>
        </li>
        <li>
          <h2>Collaboration over heroics</h2>
          <p>We believe complex problems are best solved by teams that bring diverse expertise, shared ownership, and open curiosity.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <ol class="rows">
        <li>
          <h3><span class="kicker">Explore</span>Novel connections</h3>
          <p>We create space for experimentation that reveals new directions at the intersection of science, design, and society.</p>
        </li>
        <li>
          <h3><span class="kicker">Refine</span>Thoughtful iteration</h3>
          <p>Every decision is tested for feasibility, ethics, accessibility, and long-term value.</p>
        </li>
        <li>
          <h3><span class="kicker">Amplify</span>Meaningful impact</h3>
          <p>We help teams create work that respects systems and improves the lives of the people it touches.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="statement">Deep tech requires both rigor and care.</h2>
      <p class="statement-body">We cultivate teams that are curious about the world they are shaping and deliberate about the futures they are helping to build.</p>
    </div>
  </section>

  <section class="section">
    <CTAPanel title="Share our way of working?">
      Join the community on Discord or apply with your project.
      <Button slot="actions" href="/apply/">Apply now</Button>
    </CTAPanel>
  </section>
</BaseLayout>
